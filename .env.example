# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TAVILY_API_KEY: Required for Tavily Search-backed LinkedIn prospect discovery.
# Get a free key from https://app.tavily.com (free monthly credits, no credit card required).
# Optional rotation: TAVILY_API_KEYS accepts a JSON array or comma-separated list.
# TAVILY_API_KEY is merged into the same pool when both fields are configured.
TAVILY_API_KEYS=""
TAVILY_API_KEY="MY_TAVILY_API_KEY"

# Optional Tavily tuning. Keep basic to conserve free credits.
TAVILY_SEARCH_DEPTH="basic"
TAVILY_MAX_RESULTS="10"
TAVILY_INCLUDE_RAW_CONTENT="true"
TAVILY_RAW_CONTENT_PERSON_LANE="false"
# TAVILY_COUNTRY: Leave empty for automatic per-search country detection from brief, or set to a documented name like "united states"
TAVILY_COUNTRY="united states"
# Provider queues preserve current throughput by default. Set interval caps only
# when a provider account needs explicit requests-per-window protection.
TAVILY_SEARCH_CONCURRENCY="3"
TAVILY_SEARCH_INTERVAL_CAP="0"
TAVILY_SEARCH_INTERVAL_MS="1000"
# Local credit reservation is OFF by default. Discovery records usage for
# telemetry and rotates through TAVILY_API_KEYS when a key is rate-limited or
# out of credits. Set PROVIDER_CREDIT_RESERVATION=true only to re-enable hard caps.
PROVIDER_CREDIT_RESERVATION="false"
TAVILY_MONTHLY_CREDIT_BUDGET="1000"
TAVILY_SCOUT_MAX_CREDITS_PER_SEARCH="6"
TAVILY_SCOUT_MAX_ADVANCED_SEARCHES="0"
TAVILY_SCOUT_EXTRACT_MAX_URLS="5"

# APEX_DB_PATH: Optional local SQLite database location for CRM lead storage.
# Defaults to .apex-data/apex-crm.sqlite when unset.
APEX_DB_PATH=".apex-data/apex-crm.sqlite"

# Bright Data MCP enrichment. Rapid/free mode exposes search_engine,
# scrape_as_markdown and scrape_batch. The app probes listTools() to check availability.
# Optional rotation: BRIGHTDATA_API_TOKENS accepts a JSON array or comma-separated list.
# BRIGHTDATA_API_TOKEN and API_TOKEN are merged into the same pool when configured.
BRIGHTDATA_API_TOKENS=""
BRIGHTDATA_API_TOKEN="MY_BRIGHTDATA_API_TOKEN"
# Set to "pro" only after explicitly upgrading. Free/Rapid mode never calls
# structured-data or browser_automation tools; scrape_batch is supported.
BRIGHTDATA_PLAN="free"
BRIGHTDATA_POLLING_TIMEOUT="110"
BRIGHTDATA_DEFAULT_SEARCH_ENGINE="google"
BRIGHTDATA_MONTHLY_REQUEST_BUDGET="5000"
BRIGHTDATA_SCOUT_MAX_REQUESTS_PER_SEARCH="20"
BRIGHTDATA_EVIDENCE_UPGRADE_MAX_URLS="8"
BRIGHTDATA_SEARCH_GEO_LOCATION="us"
BRIGHTDATA_ENRICHMENT_CAP=""
BRIGHTDATA_CACHE_TTL_DAYS="7"
BRIGHTDATA_BASE_TIMEOUT="180"
BRIGHTDATA_SEARCH_CONCURRENCY="2"
BRIGHTDATA_SEARCH_INTERVAL_CAP="0"
BRIGHTDATA_SEARCH_INTERVAL_MS="1000"
# One bounded application retry covers malformed/empty HTTP-success responses
# that occur after the MCP package's own network retry loop has completed.
BRIGHTDATA_SEARCH_RETRY_MAX="1"
BRIGHTDATA_SEARCH_RETRY_BASE_DELAY_MS="750"
# Max URLs per Bright Data scrape batch (clamped 1-20, default 10).
BRIGHTDATA_SCRAPE_BATCH_MAX_URLS="10"

# Local MCP server subprocess overrides
BASE_TIMEOUT="180"
BASE_MAX_RETRIES="2"
# Self-healing for Bright Data's transient empty-200 SERP bodies (surfaced by the
# MCP package as "Unexpected non-JSON response"). The service retries the search
# once after a short pause before any fallback fires. Challenge/lockout pages are
# never retried (Bright Data enforces a >=15s per-query lockout).
BRIGHTDATA_SEARCH_EMPTY_BODY_RETRIES="1"
BRIGHTDATA_SEARCH_EMPTY_BODY_RETRY_DELAY_MS="1500"
# Set to true to forward the local MCP subprocess stderr unfiltered.
BRIGHTDATA_MCP_STDERR_DEBUG="false"

# Lead Search Pipeline Tunables
LEAD_SEARCH_MAX_ROUNDS="6"
LEAD_SEARCH_MIN_SCORE="4"
# Safety timeout for synchronous discovery sessions. Unset = 15 minutes.
# Set to "0" to disable entirely.
LEAD_SEARCH_TIMEOUT_MS="900000"
# Retries per extraction chunk on transient LLM errors (0-2, default 1).
LEAD_EXTRACTION_CHUNK_RETRIES="1"
# Max trace events kept in memory per session (500-20000, default 2000).
LEAD_TELEMETRY_MAX_EVENTS="2000"
# Judge prompt token diet: leave empty for dynamic batch-proportional scaling
# (5-8 evidence items and 1800-3600 chars per item), or set explicit overrides.
FINALIST_JUDGE_MAX_EVIDENCE_ITEMS=""
FINALIST_JUDGE_EVIDENCE_CHARS=""
# Emit session logs as JSON lines instead of "[iso] msg".
# Candidate pool cushion multiplier relative to target limit (clamped 1.10 - 2.0, default dynamic 1.15 - 1.25).
LEAD_SEARCH_RERANK_POOL_MULTIPLIER="2.0"
LEAD_SEARCH_RERANK_POOL_MAX="240"
# After enough finalist-attributed history exists, execute the highest-value
# query/provider arms while retaining UCB exploration and a person lane.
# Leave LEAD_ADAPTIVE_TASKS_PER_ROUND empty for dynamic shortfall/recovery scaling (3-12).
LEAD_ADAPTIVE_SCHEDULER_ENABLED="true"
LEAD_ADAPTIVE_TASKS_PER_ROUND=""
LEAD_ADAPTIVE_MIN_OUTCOME_RUNS="8"
LEAD_ADAPTIVE_EXPLORATION_STRENGTH="1.25"
LEAD_ADAPTIVE_EXPLORATION_FLOOR_EVERY="3"
LEAD_ADAPTIVE_CENTROID_ENABLED="true"
LEAD_ADAPTIVE_REWARD_V2="false"
LEAD_JUDGE_PASS_RATE_ASSUMPTION="0.7"
LEAD_VERIFY_BORDERLINE_PER_ROUND="5"
BRIGHTDATA_MCP_TRANSPORT="local"
BRIGHTDATA_FAILURE_COOLDOWN_MS="5000"
# Dual-provider discovery. hybrid|bd_primary|tavily_primary
DISCOVERY_PROVIDER_MODE="hybrid"
# Bright Data search. Values: off, fallback, secondary, primary, always.
# When unset, hybrid/bd_primary default to primary search.
BRIGHTDATA_SEARCH_MODE="primary"

# Intelligent Hard Terms & PIQ-BOS Feature Flags
# All flags default to ON (true) as standard engine architecture.
PROGRESSIVE_QUALIFICATION_ENABLED="true"
EVIDENCE_AWARE_HARDNESS_ENABLED="true"
CLASS_AWARE_SCHEDULER_ENABLED="true"
FUZZY_QUOTE_GROUNDING_ENABLED="true"
SAFE_SLUG_PROBE_ENABLED="true"
COMPANY_ENTITY_REGISTRY_ENABLED="true"
ANCHORED_FLYWHEEL_QUERIES_ENABLED="true"
FULL_JITTER_RETRY_ENABLED="true"

# Post-filter profile enrichment controls (markdown unlock via free scrape_as_markdown).
BRIGHTDATA_PROFILE_ENRICHMENT_STAGE="post_filter"
BRIGHTDATA_PROFILE_CONCURRENCY="1"
BRIGHTDATA_PROFILE_MAX_PER_SEARCH=""
BRIGHTDATA_PROFILE_RETRY_MAX="2"

# Post-collection company intent enrichment controls (leave max empty for dynamic ceil(targetLimit * 0.75) scaling)
BRIGHTDATA_COMPANY_INTENT_ENABLED="true"
ENRICH_SHORTFALL_LEADS="true"
BRIGHTDATA_COMPANY_INTENT_MAX_PER_SEARCH=""
BRIGHTDATA_COMPANY_INTENT_CONCURRENCY="3"

# Company site evidence stitching probe (tavilyExtract fallback for unenriched candidates)
LEAD_SITE_PROBE_ENABLED="true"
LEAD_SITE_PROBE_MAX_PER_ROUND="12"

# LLM Provider & Fallback Configuration
# Direct app-side provider chain with automatic fallback, circuit breaking, and concurrency control.

# Primary Byesu/OpenAI-compatible provider
OPENAI_API_KEY="sk-..."
BYESU_API_KEY="sk-..."
OPENAI_BASE="https://byesu.com/v1"
OPENAI_MODEL="gpt-5.6-terra"
OPENAI_PROVIDER_NAME="Byesu"

# OpenRouter fallback
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_BASE_URL="https://api.mistral.ai/v1/"
OPENROUTER_MODEL="devstral-2512"
OPENROUTER_PROVIDER_NAME="Mistral"
OPENROUTER_APP_TITLE="Apex CRM"
OPENROUTER_HTTP_REFERER=""

# Groq fallback
GROQ_API_KEY="gsk-..."
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_MAX_OUTPUT_TOKENS="950"

# Atria primary (self-hosted vLLM, reasoning model).
# Routing: Atria and Byesu form the PRIMARY pair and run in parallel, one request each, with
# Atria preferred whenever its slot is free. Groq (then OpenRouter/Mistral) is the FAILSAFE
# tier and is used only when both primaries are out - never because they are busy.
# Atria is registered only when ATRIA_API_KEY is set.
ATRIA_API_KEY=""
ATRIA_BASE="https://api.atria-asi.ai/v1"
ATRIA_MODEL="Atria-Dawn-Preview"
ATRIA_PROVIDER_NAME="Atria"
# Never time out while reasoning (10 min safety ceiling, 120s floor)
ATRIA_MAX_TIMEOUT_MS="600000"
ATRIA_MIN_TIMEOUT_MS="120000"

# Provider-affinity concurrency: concurrent requests handled simultaneously (up to 4)
ATRIA_CONCURRENT_SLOTS="4"
BYESU_CONCURRENT_SLOTS="4"

# JSON output mode:
# on = always send response_format: { type: "json_object" }.
# off = never send response_format.
# auto = send response_format first; fallback to prompt-based JSON if rejected.
LLM_JSON_MODE="auto"

# Max active mining sessions across the application: strictly 1 to preserve provider slots
APEX_MAX_CONCURRENT_SESSIONS="1"
# Queue wait timeout scales dynamically with active provider ceiling and refreshes on slot progress.
LLM_QUEUE_TIMEOUT_MS=""

# Provider error handling & timeouts
# Bounded to 115000ms strictly within Cloudflare 120s proxy cutoff.
LLM_TIMEOUT_MS="115000"
LLM_FINALIST_TIMEOUT_MS="90000"
LLM_CONTRACT_TIMEOUT_MS="90000"
LLM_EXTRACTION_TIMEOUT_MS="90000"
# Same-provider retries for 5xx/network errors AND 429s (LLM_RETRY_429 only matters when this
# is >= 1). Provider fallback owns recovery, so 0 is the default. A per-call value in code wins.
LLM_MAX_RETRIES="0"
LLM_RETRY_429="true"
LLM_PROVIDER_TOKEN_BUDGET="24000"
LLM_TOKEN_SAFETY_MARGIN="400"
LLM_SESSION_PROVIDER_FAILURE_THRESHOLD="4"
# Cooldown applied to a provider when a transient failure or rate limit is encountered (ms, default 5000).
LLM_PROVIDER_COOLDOWN_MS="5000"

# Lead extraction LLM controls.
LEAD_EXTRACTION_MAX_TOKENS="4000"
LEAD_EXTRACTION_CHUNK_CHARS="8000"
LEAD_EXTRACTION_MAX_BLOCKS_PER_CHUNK="3"
LEAD_EXTRACTION_CONCURRENCY="4"
LEAD_EXTRACTION_FAILURE_ROUNDS_BEFORE_STOP="2"
FINALIST_JUDGE_CONCURRENCY="4"
FINALIST_JUDGE_MICRO_BATCH_SIZE="2"
# Evidence grounding for judge passes: strict (default) degrades uncited passes
# to unknown; legacy preserves historical replay behavior.
EVIDENCE_GROUNDING_MODE="strict"

# Company Attribution
LEAD_COMPANY_ATTRIBUTION_ENABLED="true"
COMPANY_ATTRIBUTION_BATCH_SIZE="4"

# Mining observability. Search logs are cached in SQLite and capped after each session write.
SEARCH_LOG_RETENTION_LIMIT="50"
# Optional estimated LLM cost rates for observability-only math. Set to your provider pricing per 1M tokens.
LLM_OBSERVABILITY_INPUT_COST_PER_1M="0"
LLM_OBSERVABILITY_OUTPUT_COST_PER_1M="0"

# Langfuse Observability & Tracing (optional)
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://us.cloud.langfuse.com"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LANGFUSE_PROJECT_ID=""

# LEAD_RETRIEVAL_CACHE_TTL_DAYS: days a Tavily search result is reused for an identical query (default 3, 0 disables, max 30).
LEAD_RETRIEVAL_CACHE_TTL_DAYS=3

# LLM_FAST_PROVIDER_IDS: optional comma-separated provider ids (atria, primary, groq, openrouter).
# Reorders providers WITHIN their tier for mechanical stages (for example "primary,atria" to try
# Byesu before Atria). It can never promote a failsafe provider (groq/openrouter) ahead of the
# primary pair. Empty keeps the configured order.
LLM_FAST_PROVIDER_IDS=

# LEAD_PLANNER_PROVIDER_ORDER: provider precedence for the strategist query planner (default "primary,atria").
# Byesu runs first for low-latency planning; falls back to Atria if Byesu times out (35s hard cap) or errors.
# Empty string keeps default provider tier order.
LEAD_PLANNER_PROVIDER_ORDER="primary,atria"

# LEAD_PARK_WITHHELD: retain candidates withheld by admission gate solely due to unproven company_type
# and re-probe with unused budget in subsequent rounds (default false, opt-in).
LEAD_PARK_WITHHELD=false

# LEAD_COMPANY_DOMAIN_LOOKUP_MAX_PER_ROUND: max basic Tavily domain lookups for strong personas lacking a domain (default 6, 0 disables).
LEAD_COMPANY_DOMAIN_LOOKUP_MAX_PER_ROUND=6

# ---------------------------------------------------------------------------
# Advanced / optional tuning (all have working defaults; uncomment to change)
# ---------------------------------------------------------------------------
# PORT=3000
# Allow PUT /api/leads (bulk replace-all). Off unless set to any non-empty value.
# APEX_ALLOW_LEGACY_REPLACE=
# Per-route cap for paid endpoints (LLM / Tavily / Bright Data), requests per minute (1-600).
# APEX_PAID_ROUTE_LIMIT_PER_MIN=120
# Log API requests slower than the threshold.
# APEX_PERF_LOGS=false
# APEX_PERF_SLOW_THRESHOLD_MS=2000
# APEX_STRUCTURED_LOGS=false

# LLM routing and recovery
# Minutes a provider stays OUT after an auth failure / exhausted quota before a re-test.
# LLM_AUTH_OUT_MS=600000
# LLM_QUOTA_OUT_MS=3600000
# How long a mining session waits for a recovering primary pair when no failsafe is configured.
# LLM_PRIMARY_RECOVERY_MAX_WAIT_MS=
# Cache structured LLM answers in SQLite (set "false" to disable).
# LLM_COMPLETION_CACHE=true
# Floor / explicit budget overrides for the reasoning providers.
# BYESU_MIN_TIMEOUT_MS=75000
# ATRIA_MAX_TOKENS=
# Max tokens for the one structured-output retry after an unparseable answer.
# LLM_STRUCTURED_RETRY_MAX_TOKENS=5000

# Discovery engine
# LEAD_SEARCH_BASE_ROUNDS=
# LEAD_SEARCH_VERBOSE_DEBUG_LOGS=false
# LEAD_MARGINAL_YIELD_STOP_ENABLED=false
# Never promote unverified candidates to fill a shortfall (leave unset/false).
# ENABLE_UNVERIFIED_SAFETY_NET_PROMOTION=false
# Days a judge PASS verdict is reused (default 14).
# LEAD_PASS_VERDICT_TTL_DAYS=14
# Judge batch size target in tokens (default 4500).
# FINALIST_JUDGE_BATCH_TOKEN_TARGET=4500
# Extraction chunking: blocks per chunk (default 6, max 12) and snippet length cap (0 = off).
# LEAD_EXTRACTION_MAX_BLOCKS_PER_CHUNK=6
# LEAD_EXTRACTION_SNIPPET_MAX_CHARS=0

# LinkedIn post-intent enrichment (on unless set to "false")
# LINKEDIN_POST_INTENT_ENABLED=true
# LINKEDIN_POST_INTENT_CONCURRENCY=3
# LINKEDIN_POST_INTENT_MAX_LEADS=20

# Bright Data tuning
# Minimum company-intent score (default 8) and plans per dataset round (default 2).
# BRIGHTDATA_COMPANY_INTENT_MIN_SCORE=8
# BRIGHTDATA_DATASET_PLANS_PER_ROUND=2
# Add random delay before searches.
# BRIGHTDATA_ENABLE_SEARCH_JITTER=false
# BRIGHTDATA_SEARCH_JITTER_MS=
# Fall back to Bing when Google serves a bot challenge (set "false" to disable).
# BRIGHTDATA_FALLBACK_ENGINE=true
# BRIGHTDATA_GOOGLE_CHALLENGE_TIMEOUT_MS=20000

# Langfuse: LANGFUSE_BASEURL is accepted as an alias of LANGFUSE_BASE_URL.
